{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "bun: compile",
      "command": "bun",
      "args": ["run", "compile"]
    },
    {
      "type": "shell",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "label": "bun: watch",
      "command": "bun",
      "args": ["run", "watch"]
    }
  ]
}
